{
    "name": "nt-fe",
    "version": "0.1.0",
    "private": true,
    "scripts": {
        "predev": "node scripts/sync-catalog.mjs && node scripts/sync-warning-i18n.mjs",
        "dev": "next dev",
        "prebuild": "node scripts/sync-catalog.mjs && node scripts/sync-warning-i18n.mjs",
        "build": "next build",
        "postbuild": "bun run --cwd near-connect build",
        "start": "next start",
        "lint": "biome check",
        "format": "biome format . --write",
        "format:check": "biome check . --formatter-enabled=true --linter-enabled=false --assist-enabled=false",
        "check:i18n": "node scripts/check-i18n.mjs",
        "proxy": "node proxy-server.js",
        "proxy:staging": "BACKEND_PROXY_TARGET=https://api.testenv.trezu.app node proxy-server.js",
        "proxy:prod": "BACKEND_PROXY_TARGET=https://api.trezu.app node proxy-server.js",
        "predev:proxied": "node scripts/sync-catalog.mjs && node scripts/sync-warning-i18n.mjs",
        "dev:proxied": "NEXT_PUBLIC_BACKEND_API_BASE=http://localhost:8888 next dev",
        "test:e2e": "playwright test",
        "test:e2e:ui": "playwright test --ui",
        "test:e2e:headed": "playwright test --headed",
        "test:e2e:docker": "docker compose -f docker-compose.e2e.yml up --build --abort-on-container-exit"
    },
    "dependencies": {
        "@defuse-protocol/intents-sdk": "^0.58.2",
        "@hookform/resolvers": "^5.7.1",
        "@hot-labs/near-connect": "NEAR-DevHub/near-connect#passkeys",
        "@near-js/transactions": "^2.5.1",
        "@radix-ui/react-checkbox": "^1.3.11",
        "@radix-ui/react-collapsible": "^1.1.20",
        "@radix-ui/react-dialog": "^1.1.23",
        "@radix-ui/react-dropdown-menu": "^2.1.24",
        "@radix-ui/react-label": "^2.1.15",
        "@radix-ui/react-popover": "^1.1.23",
        "@radix-ui/react-scroll-area": "^1.2.18",
        "@radix-ui/react-select": "^2.3.7",
        "@radix-ui/react-separator": "^1.1.15",
        "@radix-ui/react-slider": "^1.4.7",
        "@radix-ui/react-slot": "^1.3.3",
        "@radix-ui/react-switch": "^1.3.7",
        "@radix-ui/react-tabs": "^1.1.21",
        "@radix-ui/react-toggle": "^1.1.18",
        "@radix-ui/react-toggle-group": "^1.1.19",
        "@radix-ui/react-tooltip": "^1.2.16",
        "@sentry/nextjs": "^10.70.0",
        "@tailwindcss/typography": "^0.5.20",
        "@tanstack/react-query": "^5.101.4",
        "@tanstack/react-query-persist-client": "^5.101.4",
        "@tanstack/react-table": "^8.21.3",
        "@tsparticles/engine": "^3.9.1",
        "@tsparticles/react": "^3.0.0",
        "@tsparticles/slim": "^3.9.1",
        "@walletconnect/sign-client": "^2.23.10",
        "axios": "^1.19.0",
        "big.js": "^7.0.1",
        "borsh": "^2.0.0",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "date-fns": "^4.4.0",
        "geoip-lite": "^1.4.10",
        "gleap": "^15.3.2",
        "gradflow": "^0.1.0",
        "lucide-react": "^0.562.0",
        "motion": "^12.43.0",
        "next": "16.3.0",
        "next-intl": "^4.13.6",
        "next-themes": "^0.4.6",
        "nextstepjs": "^2.3.0",
        "papaparse": "^5.5.4",
        "posthog-js": "^1.415.1",
        "radix-ui": "^1.6.7",
        "react": "19.2.7",
        "react-day-picker": "^9.14.0",
        "react-dom": "19.2.7",
        "react-hook-form": "^7.85.0",
        "react-qr-code": "^2.2.0",
        "recharts": "2.15.4",
        "sonner": "^2.0.8",
        "tailwind-merge": "^3.6.0",
        "use-debounce": "^10.1.1",
        "zod": "^4.4.3",
        "zustand": "^5.0.14"
    },
    "devDependencies": {
        "@biomejs/biome": "2.2.0",
        "@near-js/crypto": "2.5.1",
        "@near-js/utils": "0.2.2",
        "@playwright/test": "^1.62.1",
        "@tailwindcss/postcss": "^4.3.3",
        "@types/big.js": "^6.2.2",
        "@types/geoip-lite": "^1.4.4",
        "@types/node": "^20.19.43",
        "@types/papaparse": "^5.5.2",
        "@types/react": "^19.2.18",
        "@types/react-dom": "^19.2.4",
        "baseline-browser-mapping": "^2.11.13",
        "buffer": "6.0.3",
        "esbuild": "^0.27.7",
        "tailwind-scrollbar": "^4.0.2",
        "tailwindcss": "^4.3.3",
        "tw-animate-css": "^1.4.0",
        "typescript": "^5.9.3",
        "vite": "^5.4.21"
    }
}
